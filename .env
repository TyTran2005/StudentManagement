# .env
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres    # Thay bằng user của bạn
DB_PASSWORD=1234567890 # Thay bằng password của bạn
DB_NAME=students   # Tên database bạn đã tạo
DB_SSLMODE=disable            # Hoặc 'require' nếu dùng SSL
SERVER_PORT=8080

JWT_SECRET_KEY=1234560  # Thay bằng một key bí mật mạnh
JWT_EXPIRATION_HOURS=72h            # Thời gian token hết hạn (giờ)